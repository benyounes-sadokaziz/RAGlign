# --- Internal design notes (per project owner: kept local, not tracked) ---
docs/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Generated artifacts ---
# Embeddings and indexes are derived data: rebuildable from corpus/ + config.
.cache/
runs/
*.npy
*.faiss

# --- Env / secrets ---
.env
.env.*
# The template carries no secret and documents what keys exist, so it is tracked.
!.env.example

# --- Recordings ---
# Demo captures are tens of megabytes and git stores them forever, badly.
# Host the video outside the repo and link it from the README.
*.mp4
*.mov
*.gif

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
